__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.DOCTORS=void 0;e.DOCTORS=[{id:1,name:'Dr. Sarah Johnson',specialty:'Primary Care Physician',image:'https://images.unsplash.com/photo-1594824476967-48c8b964273f?auto=format&fit=crop&w=200&h=200&q=80',rating:4.9,reviewSummary:{total:156,distribution:{5:120,4:25,3:8,2:2,1:1},detailedRatings:{medicalExpertise:4.9,communication:4.8,waitTime:4.5,staffFriendliness:4.7,facilityAndCleanliness:4.8}},reviews:[{id:1,author:'John Doe',avatar:'https://images.unsplash.com/photo-1599566150163-29194dcaad36?auto=format&fit=crop&w=60&h=60&q=80',rating:5,date:'2 weeks ago',comment:'Excellent doctor, very thorough and professional. Took the time to explain everything clearly.',helpful:12,replies:2,detailedRatings:{medicalExpertise:5,communication:5,waitTime:4.5,staffFriendliness:5,facilityAndCleanliness:5}},{id:2,author:'Jane Smith',avatar:'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=60&h=60&q=80',rating:5,date:'1 month ago',comment:'Very knowledgeable and caring. Made me feel comfortable throughout the consultation.',helpful:8,detailedRatings:{medicalExpertise:5,communication:5,waitTime:4.5,staffFriendliness:4.5,facilityAndCleanliness:5}},{id:3,author:'Mike Johnson',avatar:'https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?auto=format&fit=crop&w=60&h=60&q=80',rating:4,date:'2 months ago',comment:'Good experience overall. Wait time was a bit long but the care was excellent.',helpful:5,detailedRatings:{medicalExpertise:4.5,communication:4,waitTime:3.5,staffFriendliness:4,facilityAndCleanliness:4.5}}],about:'Dr. Sarah Johnson is a board-certified primary care physician with over 10 years of experience. She specializes in preventive medicine, chronic disease management, and women\'s health. Dr. Johnson takes a holistic approach to healthcare, focusing on the whole person rather than just treating symptoms. She believes in building strong doctor-patient relationships and empowering patients through education about their health.',quote:'My goal is to partner with my patients to help them achieve their best possible health. I believe in preventive care and addressing the root causes of health issues rather than just treating symptoms. I take the time to listen to my patients\' concerns and work with them to develop personalized treatment plans that fit their lifestyle and preferences.',experience:'10 years',languages:['English','French','German'],location:'Luxembourg Medical Center',address:'23 Boulevard Royal, L-2449 Luxembourg',distance:'0.8 km',consultationFees:{inPerson:'\u20ac80',online:'\u20ac60'},education:[{id:1,degree:'Doctor of Medicine',institution:'University of Luxembourg Medical School',year:'2010'},{id:2,degree:'Residency in Family Medicine',institution:'Luxembourg General Hospital',year:'2013'},{id:3,degree:'Fellowship in Integrative Medicine',institution:'University of Arizona',year:'2014'}],specializations:['Preventive Medicine','Chronic Disease Management','Women\'s Health','Integrative Medicine'],services:[{id:1,name:'General Consultation',duration:'30 min',price:'\u20ac80',popular:!0},{id:2,name:'Annual Health Check-up',duration:'60 min',price:'\u20ac150',popular:!0},{id:3,name:'Follow-up Visit',duration:'20 min',price:'\u20ac60'}],team:[{id:1,name:'Marie Dubois',role:'Nurse Practitioner',image:'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=60&h=60&q=80',location:'Luxembourg Medical Center',isVerified:!0,specialties:['Primary Care','Preventive Medicine'],languages:['French','English','German']},{id:2,name:'Thomas Weber',role:'Medical Assistant',image:'https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=60&h=60&q=80',location:'Luxembourg Medical Center',isVerified:!0,specialties:['Patient Care','Clinical Procedures'],languages:['German','English','French']}],locations:[{id:'main',name:'Luxembourg Medical Center',address:'23 Boulevard Royal,